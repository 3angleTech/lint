{
  "name": "@3angletech/eslint-config",
  "version": "24.2.0",
  "type": "module",
  "description": "Shareable Flat ESLint configuration library",
  "author": {
    "name": "The 3angle.tech team",
    "email": "contact@3angle.tech",
    "url": "https://3angle.tech"
  },
  "license": "MIT",
  "homepage": "https://github.com/3angleTech/lint#readme",
  "keywords": [
    "eslint",
    "eslint-config",
    "lint",
    "stylelint",
    "stylelint-config",
    "typescript",
    "angular",
    "nestjs"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/3angleTech/lint.git"
  },
  "exports": {
    ".": "./src/index.mjs",
    "./angular": "./src/configs/angular/index.js",
    "./nestjs": "./src/configs/nestjs/index.js",
    "./node": "./src/configs/node/index.js",
    "./style": "./src/configs/style/index.js",
    "./base": "./src/configs/base.mjs"
  },
  "files": [
    "src",
    "LICENSE.md",
    "README.md",
    "MIGRATION.md",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=24.15.0"
  },
  "scripts": {
    "test": "node tests/smoke-test.mjs",
    "lint": "eslint src"
  },
  "peerDependencies": {
    "eslint": ">=9.0.0",
    "typescript": ">=5.0.0",
    "angular-eslint": ">=21.0.0 <23.0.0",
    "typescript-eslint": ">=8.0.0"
  },
  "peerDependenciesMeta": {
    "angular-eslint": {
      "optional": true
    },
    "typescript": {
      "optional": true
    }
  },
  "dependencies": {
    "@stylistic/eslint-plugin": "^4.2.0",
    "angular-eslint": "^21.2.0 || ^22.1.0",
    "eslint-plugin-import": "^2.31.0",
    "eslint-plugin-jsdoc": "^50.6.0",
    "eslint-plugin-promise": "^7.2.0",
    "eslint-plugin-security": "^3.0.0",
    "eslint-plugin-sonarjs": "^4.0.3",
    "typescript-eslint": "^8.54.0",
    "globals": "^15.0.0"
  },
  "devDependencies": {
    "@types/eslint": "^9.6.0",
    "@types/node": "^22.15.0",
    "eslint": "^9.25.0",
    "typescript": "^5.7.0"
  }
}
